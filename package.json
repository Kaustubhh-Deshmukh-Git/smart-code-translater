{
  "name": "smart-code-translater-root",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "server/**/*.{js,json}": [
      "npm --prefix server run lint:fix",
      "prettier --write"
    ],
    "client/**/*.{js,jsx,json,css}": [
      "npm --prefix client run lint:fix",
      "prettier --write"
    ]
  }
}
